	(text "J101: use a connector and cable rated for the full input current; 3.5 mm clone terminals are not assumed to be 25 A."
		(exclude_from_sim no)
		(at 20.32 124.46 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "892546b0-aafd-5ee8-8906-1ec7f5f6795f")
	)
	(text "D101 is a surge clamp, not an over-current device. Q101 needs a P-channel MOSFET with VDS >= 30 V and low RDS(on) at the selected gate drive.\nR101/R102 define the default ON state; D102 limits |VGS|. Verify body-diode orientation, inrush, SOA and thermal rise."
		(exclude_from_sim no)
		(at 20.32 136 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "ae689d34-579b-5f39-8517-492948fdae1f")
	)
	(text "F102 protects the 12 V fans/pump/PTC branch. F103 protects the three LED boost channels. Fuse ratings and time-current curves are preliminary until cable and startup measurements."
		(exclude_from_sim no)
		(at 20.32 158 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "bd9a9a00-e36a-5921-a249-5b8e8d792184")
	)
